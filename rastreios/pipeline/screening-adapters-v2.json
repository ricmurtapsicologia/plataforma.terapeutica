{
  "schemaVersion": "2.0.0",
  "contract": {
    "purpose": "Resolve explicitamente o alvo estrutural e os campos de identificação de cada fluxo público de rastreio.",
    "noHeuristicFormSelection": true,
    "legacyContainerPolicy": "Fluxos sem form nativo podem receber a camada visual e sincronizar campos legados, mas não podem presumir submissão nem entrega até refatoração nativa."
  },
  "instruments": {
    "geral": {
      "repo": "Rastreioclinico",
      "sourcePath": "index.html",
      "mode": "form",
      "formSelector": "#racForm",
      "submissionSupported": true,
      "identity": {"name": "#patientName", "birth": "#birthDate", "application": "#responseDate"}
    },
    "tdah": {
      "repo": "rastreioTDAH",
      "sourcePath": "index.html",
      "mode": "form",
      "formSelector": "#form",
      "submissionSupported": true,
      "identity": {"name": "#name", "birth": "#birthDate", "application": "#date"}
    },
    "bipolar": {
      "repo": "tab-bateria-integrada",
      "sourcePath": "index.html",
      "mode": "legacyContainer",
      "containerSelector": ".wrap",
      "identityAnchorSelector": "#nome",
      "identityBlockSelector": "section.card",
      "submissionSupported": false,
      "identity": {"name": "#nome", "birth": null, "application": "#data"}
    },
    "borderline": {
      "repo": "Inventario-de-Tracos-Borderline",
      "sourcePath": "index.html",
      "mode": "form",
      "formSelector": "#form",
      "submissionSupported": true,
      "identity": {"name": "#fullName", "birth": null, "application": "#date"}
    },
    "narcisismo": {
      "repo": "bateria.narcisismo",
      "sourcePath": "index.html",
      "mode": "legacyContainer",
      "containerSelector": ".wrap",
      "identityAnchorSelector": "#nome",
      "identityBlockSelector": "section.card",
      "submissionSupported": false,
      "identity": {"name": "#nome", "birth": null, "application": "#data"}
    },
    "impulsividade": {
      "repo": "Rastreio-de-Impulsividade",
      "sourcePath": "index.html",
      "mode": "form",
      "formSelector": "#scaleForm",
      "submissionSupported": true,
      "identity": {"name": "#fullName", "birth": null, "application": "#date"}
    },
    "esquemas": {
      "repo": "rastreio.de.esquemas",
      "sourcePath": "index.html",
      "mode": "legacyContainer",
      "containerSelector": ".container",
      "identityAnchorSelector": "#nomeCompleto",
      "identityBlockSelector": "#userdataSection",
      "submissionSupported": false,
      "identity": {"name": "#nomeCompleto", "birth": null, "application": "#dataAplicacao"}
