{
  "schemaVersion": "2.2.0",
  "contract": {
    "purpose": "Resolve explicitamente o alvo estrutural, o perfil de identidade e o transporte real de cada fluxo público.",
    "noHeuristicFormSelection": true,
    "legacyContainerPolicy": "Fluxos sem form nativo podem receber a camada visual e sincronizar campos legados, mas não podem presumir submissão nem entrega até refatoração nativa.",
    "formWithoutSubmissionPolicy": "A presença de form nativo é estrutural e não autoriza entrega. submissionSupported=true só é permitido quando o manifesto canônico declara formState=ACTIVE.",
    "identityProfiles": {
      "screening_canonical": {
        "required": ["name", "birth", "application"],
        "policy": "Rastreios clínicos exigem nome completo, data de nascimento e data de aplicação com destino persistente explícito."
      },
      "monitoring_longitudinal": {
        "required": ["name"],
        "derived": ["application"],
        "policy": "Monitoramentos longitudinais reutilizam somente identidade realmente persistida no coletor; data de aplicação pode ser derivada do timestamp. Não sintetizar nascimento sem campo de destino."
      }
    }
  },
  "instruments": {
    "geral": {"repo":"Rastreioclinico","sourcePath":"index.html","mode":"form","formSelector":"#racForm","submissionSupported":false,"identityProfile":"screening_canonical","identity":{"name":"#patientName","birth":"#birthDate","application":"#responseDate"},"identityTransport":{"name":"native_field","birth":"native_field","application":"native_field"}},
    "tdah": {"repo":"rastreioTDAH","sourcePath":"index.html","mode":"form","formSelector":"#form","submissionSupported":false,"identityProfile":"screening_canonical","identity":{"name":"#name","birth":"#birthDate","application":"#date"},"identityTransport":{"name":"native_field","birth":"native_field","application":"native_field"}},
    "bipolar": {"repo":"tab-bateria-integrada","sourcePath":"index.html","mode":"form","formSelector":"#screeningForm","submissionSupported":false,"identityProfile":"screening_canonical","identity":{"name":"#nome","birth":"#dataNascimento","application":"#data"},"identityTransport":{"name":"native_field","birth":"native_field","application":"native_field"}},
    "borderline": {"repo":"Inventario-de-Tracos-Borderline","sourcePath":"index.html","mode":"form","formSelector":"#form","submissionSupported":false,"identityProfile":"screening_canonical","identity":{"name":"#fullName","birth":"#birthDate","application":"#date"},"identityTransport":{"name":"native_field","birth":"native_field","application":"native_field"}},
    "narcisismo": {"repo":"bateria.narcisismo","sourcePath":"index.html","mode":"form","formSelector":"#screeningForm","submissionSupported":false,"identityProfile":"screening_canonical","identity":{"name":"#nome","birth":"#dataNascimento","application":"#data"},"identityTransport":{"name":"native_field","birth":"native_field","application":"native_field"}},
